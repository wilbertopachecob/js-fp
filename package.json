{
  "name": "js-fp",
  "version": "2.1.0",
  "description": "Functional programming utilities in TypeScript — curated from book exercises with tests and docs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "js-fp": "bin/js-fp.js"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "test": "jest",
    "test:all": "npm run build && jest",
    "test:coverage": "npm run build && jest --coverage",
    "demo": "npm run build && node bin/js-fp.js",
    "docs": "npm run build && typedoc --out docs src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Wilberto Pacheco Batista",
  "license": "GPL-3.0",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1"
  }
}
