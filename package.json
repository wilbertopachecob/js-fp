{
  "name": "js-fp",
  "version": "2.1.0",
  "description": "Functional programming utilities in TypeScript — curated from book exercises with tests and docs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "js-fp": "bin/js-fp.js"
  },
  "scripts": {
    "build": "tsc && tsc-alias -p tsconfig.json",
    "build:webpack": "webpack",
    "prepare": "npm run build",
    "test": "jest",
    "test:ts": "npm run build && jest --testMatch='**/tests/**/*.test.ts'",
    "test:chapters": "jest --testMatch='**/Chapter_*/**/*.test.js'",
    "test:all": "npm run build && jest",
    "test:coverage": "npm run build && jest --coverage",
    "demo": "npm run build && node bin/js-fp.js",
    "docs": "npm run build && typedoc --out docs src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Wilberto Pacheco Batista",
  "license": "GPL-3.0",
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.6",
    "tsc-alias": "^1.8.10",
    "ts-loader": "^9.5.2",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "jsdom": "^25.0.1"
  }
}
